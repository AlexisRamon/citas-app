@@ -0,0 +1,115 @@
+"use server";
+
+import { getClinicDateIso, getClinicTime } from "@/lib/clinic-time";
+import { buildCancellationEmail, sendEmail } from "@/lib/email";
+import { formatLongDate, formatTimeLabel } from "@/lib/format-date";
+import { createClient } from "@/lib/supabase/server";
+
+export type CancelResult =
+  | { ok: true; emailSent: boolean }
+  | { ok: false; error: string };
+
+const UUID_REGEX =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const MAX_MESSAGE_LENGTH = 300;
+
+type ProfileRow = {
+  tenant_id: string;
+  tenants: {
+    name: string;
+    slug: string;
+    address: string | null;
+    phone: string | null;
+  } | null;
+};
+
+type AppointmentRow = {
+  id: string;
+  starts_at: string;
+  patient_name: string | null;
+  patient_email: string | null;
+  status: string;
+};
+
+export async function cancelAppointment(
+  id: string,
+  message?: string,
+): Promise<CancelResult> {
+  if (!UUID_REGEX.test(id)) {
+    return { ok: false, error: "Cita inválida." };
+  }
+
+  const note = (message ?? "").trim().slice(0, MAX_MESSAGE_LENGTH);
+
+  const supabase = await createClient();
+
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+
+  if (!user) {
+    return { ok: false, error: "Tu sesión expiró. Inicia sesión de nuevo." };
+  }
+
+  const { data: profile } = await supabase
+    .from("doctor_profiles")
+    .select("tenant_id, tenants(name, slug, address, phone)")
+    .eq("user_id", user.id)
+    .maybeSingle<ProfileRow>();
+
+  if (!profile || !profile.tenants) {
+    return { ok: false, error: "Tu cuenta no tiene acceso a este consultorio." };
+  }
+
+  // Todo se lee de la base: el navegador solo manda el id de la cita.
+  const { data: appointment } = await supabase
+    .from("appointments")
+    .select("id, starts_at, patient_name, patient_email, status")
+    .eq("id", id)
+    .eq("tenant_id", profile.tenant_id)
+    .maybeSingle<AppointmentRow>();
+
+  if (!appointment) {
+    return { ok: false, error: "No encontramos la cita." };
+  }
+
+  if (appointment.status !== "confirmed") {
+    return { ok: false, error: "Solo se pueden cancelar citas confirmadas." };
+  }
+
+  const { error: updateError, count } = await supabase
+    .from("appointments")
+    .update({ status: "cancelled" }, { count: "exact" })
+    .eq("id", id)
+    .eq("tenant_id", profile.tenant_id)
+    .eq("status", "confirmed");
+
+  if (updateError || !count) {
+    return { ok: false, error: "No pudimos cancelar la cita. Inténtalo de nuevo." };
+  }
+
+  if (!appointment.patient_email) {
+    return { ok: true, emailSent: false };
+  }
+
+  const domain = process.env.NEXT_PUBLIC_APP_DOMAIN;
+  const tenant = profile.tenants;
+
+  const email = buildCancellationEmail({
+    patientName: appointment.patient_name ?? "paciente",
+    doctorName: tenant.name,
+    dateLabel: formatLongDate(getClinicDateIso(appointment.starts_at)),
+    timeLabel: formatTimeLabel(getClinicTime(appointment.starts_at)),
+    address: tenant.address ?? "",
+    phone: tenant.phone ?? "",
+    message: note,
+    bookingUrl: domain ? `https://${domain}/${tenant.slug}/agendar` : null,
+  });
+
+  const emailSent = await sendEmail({
+    to: appointment.patient_email,
+    ...email,
+  });
+
+  return { ok: true, emailSent };
+}
diff --git a/src/lib/email.ts b/src/lib/email.ts
new file mode 100644
index 0000000..6548a85
--- /dev/null
+++ b/src/lib/email.ts
@@ -0,0 +1,113 @@
+// Correos transaccionales vía la API de Resend. Solo se usa desde el servidor
+// (server actions / route handlers): RESEND_API_KEY nunca llega al navegador.
+
+const RESEND_URL = "https://api.resend.com/emails";
+const DEFAULT_FROM = "Citas App <onboarding@resend.dev>";
+const TIMEOUT_MS = 8000;
+
+export function escapeHtml(value: string) {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+type SendEmailInput = {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+};
+
+/** Devuelve true si Resend aceptó el correo. Nunca lanza. */
+export async function sendEmail(input: SendEmailInput): Promise<boolean> {
+  const apiKey = process.env.RESEND_API_KEY;
+  if (!apiKey) return false;
+
+  try {
+    const response = await fetch(RESEND_URL, {
+      method: "POST",
+      headers: {
+        Authorization: `Bearer ${apiKey}`,
+        "Content-Type": "application/json",
+      },
+      body: JSON.stringify({
+        from: process.env.RESEND_FROM ?? DEFAULT_FROM,
+        to: [input.to],
+        subject: input.subject,
+        html: input.html,
+        text: input.text,
+      }),
+      signal: AbortSignal.timeout(TIMEOUT_MS),
+    });
+
+    return response.ok;
+  } catch {
+    return false;
+  }
+}
+
+type CancellationEmailInput = {
+  patientName: string;
+  doctorName: string;
+  dateLabel: string;
+  timeLabel: string;
+  address: string;
+  phone: string;
+  message: string;
+  bookingUrl: string | null;
+};
+
+export function buildCancellationEmail(input: CancellationEmailInput) {
+  const subject = `Tu cita del ${input.dateLabel} fue cancelada`;
+
+  const text = [
+    `Hola ${input.patientName},`,
+    "",
+    `${input.doctorName} canceló tu cita del ${input.dateLabel} a las ${input.timeLabel}.`,
+    input.message ? `\nMensaje del consultorio: ${input.message}` : "",
+    input.bookingUrl ? `\nPuedes agendar otra cita aquí: ${input.bookingUrl}` : "",
+    input.phone ? `\nSi tienes dudas, contacta al consultorio: ${input.phone}` : "",
+    input.address ? `Dirección: ${input.address}` : "",
+  ]
+    .filter((line, index, all) => line !== "" || all[index - 1] !== "")
+    .join("\n");
+
+  const e = escapeHtml;
+
+  const html = `
+<div style="font-family: Arial, Helvetica, sans-serif; max-width: 480px; margin: 0 auto; padding: 24px; color: #243b36;">
+  <h2 style="margin: 0 0 12px; font-size: 20px;">Tu cita fue cancelada</h2>
+  <p style="margin: 0 0 16px; font-size: 14px;">Hola ${e(input.patientName)},</p>
+  <p style="margin: 0 0 16px; font-size: 14px;">
+    ${e(input.doctorName)} canceló tu cita del
+    <strong>${e(input.dateLabel)}</strong> a las <strong>${e(input.timeLabel)}</strong>.
+  </p>
+  ${
+    input.message
+      ? `<p style="margin: 0 0 16px; padding: 12px; background: #eaf2ec; border-radius: 8px; font-size: 14px;">
+    <strong>Mensaje del consultorio:</strong><br />${e(input.message)}
+  </p>`
+      : ""
+  }
+  ${
+    input.bookingUrl
+      ? `<p style="margin: 0 0 16px; font-size: 14px;">
+    Puedes <a href="${e(input.bookingUrl)}" style="color: #28685c;">agendar otra cita aquí</a>.
+  </p>`
+      : ""
+  }
+  ${
+    input.phone || input.address
+      ? `<p style="margin: 0; font-size: 12px; color: #65736e;">
+    ${input.phone ? `Teléfono: ${e(input.phone)}<br />` : ""}
+    ${input.address ? `Dirección: ${e(input.address)}` : ""}
+  </p>`
+      : ""
+  }
+</div>`.trim();
+
+  return { subject, html, text };
+}
