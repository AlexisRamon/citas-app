diff --git a/src/app/[tenant]/mi-cita/MiCitaLogin.tsx b/src/app/[tenant]/mi-cita/MiCitaLogin.tsx
new file mode 100644
index 0000000..db1a96b
--- /dev/null
+++ b/src/app/[tenant]/mi-cita/MiCitaLogin.tsx
@@ -0,0 +1,215 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { LogIn, Mail } from "lucide-react";
+import { Button } from "@/components/ui/Button";
+import { Input } from "@/components/ui/Input";
+import { OTPInput } from "@/components/ui/OTPInput";
+import { OTP_LENGTH, RESEND_SECONDS } from "@/lib/auth-config";
+import { createClient } from "@/lib/supabase/client";
+
+const EMAIL_REGEX = /^\S+@\S+\.\S+$/;
+
+type MiCitaLoginProps = {
+  onLoggedIn: () => void;
+};
+
+export function MiCitaLogin({ onLoggedIn }: MiCitaLoginProps) {
+  const supabase = createClient();
+
+  const [step, setStep] = useState<"email" | "code">("email");
+  const [email, setEmail] = useState("");
+  const [code, setCode] = useState("");
+  const [error, setError] = useState<string | undefined>(undefined);
+  const [busy, setBusy] = useState(false);
+  const [secondsLeft, setSecondsLeft] = useState(0);
+
+  useEffect(() => {
+    if (secondsLeft === 0) return;
+
+    const interval = setInterval(() => {
+      setSecondsLeft((current) => Math.max(current - 1, 0));
+    }, 1000);
+
+    return () => clearInterval(interval);
+  }, [secondsLeft]);
+
+  // Solo enviamos código a correos que ya existen (shouldCreateUser: false).
+  // Si el correo nunca ha agendado, respondemos igual para no revelar qué
+  // correos están registrados; la verificación fallará con "código incorrecto".
+  async function sendCode(target: string) {
+    const { error: otpError } = await supabase.auth.signInWithOtp({
+      email: target,
+      options: { shouldCreateUser: false },
+    });
+
+    if (!otpError) return true;
+    return otpError.code === "otp_disabled" || /not allowed/i.test(otpError.message);
+  }
+
+  async function handleSendEmail() {
+    if (busy) return;
+
+    const normalized = email.trim().toLowerCase();
+    if (!EMAIL_REGEX.test(normalized)) {
+      setError("Ingresa un correo válido");
+      return;
+    }
+
+    setBusy(true);
+    setError(undefined);
+
+    const ok = await sendCode(normalized);
+    setBusy(false);
+
+    if (!ok) {
+      setError("No pudimos enviar el código. Inténtalo de nuevo.");
+      return;
+    }
+
+    setEmail(normalized);
+    setCode("");
+    setSecondsLeft(RESEND_SECONDS);
+    setStep("code");
+  }
+
+  async function handleVerify() {
+    if (busy) return;
+
+    if (code.length < OTP_LENGTH) {
+      setError(`Ingresa los ${OTP_LENGTH} dígitos`);
+      return;
+    }
+
+    setBusy(true);
+    setError(undefined);
+
+    const { data, error: verifyError } = await supabase.auth.verifyOtp({
+      email,
+      token: code,
+      type: "email",
+    });
+
+    setBusy(false);
+
+    if (verifyError || !data.user) {
+      setError("Código incorrecto o vencido. Inténtalo de nuevo.");
+      return;
+    }
+
+    onLoggedIn();
+  }
+
+  async function handleResend() {
+    if (busy || secondsLeft > 0) return;
+
+    setBusy(true);
+    setError(undefined);
+
+    const ok = await sendCode(email);
+    setBusy(false);
+
+    if (!ok) {
+      setError("No pudimos reenviar el código. Inténtalo de nuevo.");
+      return;
+    }
+
+    setCode("");
+    setSecondsLeft(RESEND_SECONDS);
+  }
+
+  return (
+    <section
+      aria-labelledby="mi-cita-login"
+      className="flex flex-col gap-ds-5 rounded-lg border border-border bg-surface p-ds-5"
+    >
+      <div className="flex flex-col gap-ds-2">
+        <h2 id="mi-cita-login" className="text-20 font-bold text-text">
+          Inicia sesión para ver tus citas agendadas
+        </h2>
+        <p className="text-14 text-text-muted">
+          Usa el mismo correo con el que agendaste. Te enviaremos un código de
+          verificación.
+        </p>
+      </div>
+
+      {step === "email" ? (
+        <>
+          <Input
+            type="email"
+            inputMode="email"
+            autoComplete="email"
+            label="Correo electrónico"
+            placeholder="tu@correo.com"
+            value={email}
+            onChange={(value) => {
+              setEmail(value);
+              if (error) setError(undefined);
+            }}
+            error={error}
+          />
+          <Button
+            variant={busy ? "disabled" : "primary"}
+            icon={<Mail size={20} aria-hidden="true" />}
+            onClick={handleSendEmail}
+            className="w-full"
+          >
+            {busy ? "Enviando…" : "Enviar código"}
+          </Button>
+        </>
+      ) : (
+        <>
+          <p className="text-14 text-text">
+            Si ese correo tiene citas, enviamos {OTP_LENGTH} dígitos a{" "}
+            <span className="font-bold">{email}</span>.
+          </p>
+          <OTPInput
+            length={OTP_LENGTH}
+            value={code}
+            onChange={(value) => {
+              setCode(value);
+              if (error) setError(undefined);
+            }}
+            error={error}
+          />
+          <Button
+            variant={busy ? "disabled" : "primary"}
+            icon={<LogIn size={20} aria-hidden="true" />}
+            onClick={handleVerify}
+            className="w-full"
+          >
+            {busy ? "Verificando…" : "Verificar e iniciar sesión"}
+          </Button>
+
+          <div className="flex flex-col items-center gap-ds-1 text-14">
+            {secondsLeft === 0 ? (
+              <button
+                type="button"
+                onClick={handleResend}
+                disabled={busy}
+                className="min-h-[44px] text-primary underline"
+              >
+                Reenviar código
+              </button>
+            ) : (
+              <p className="flex min-h-[44px] items-center text-text-muted">
+                Reenviar código en {secondsLeft} s
+              </p>
+            )}
+            <button
+              type="button"
+              onClick={() => {
+                setStep("email");
+                setCode("");
+                setError(undefined);
+              }}
+              className="min-h-[44px] text-primary underline"
+            >
+              Cambiar correo
+            </button>
+          </div>
+        </>
+      )}
+    </section>
+  );
+}
