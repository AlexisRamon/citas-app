diff --git a/src/lib/booking.ts b/src/lib/booking.ts
new file mode 100644
index 0000000..e1043df
--- /dev/null
+++ b/src/lib/booking.ts
@@ -0,0 +1,22 @@
+import { getNowMs, zonedDateTimeToUtc } from "@/lib/clinic-time";
+
+export const SLOT_MINUTES = 30;
+export const HOLD_MINUTES = 10;
+
+/** Inicio del slot como instante UTC (la hora se lee en zona del consultorio). */
+export function getSlotStart(isoDate: string, time: string): Date {
+  return zonedDateTimeToUtc(isoDate, time);
+}
+
+/** Campos de tiempo para insertar un hold temporal en `appointments`. */
+export function buildHold(isoDate: string, time: string) {
+  const startsAt = getSlotStart(isoDate, time);
+  const endsAt = new Date(startsAt.getTime() + SLOT_MINUTES * 60 * 1000);
+  const holdExpiresAt = new Date(getNowMs() + HOLD_MINUTES * 60 * 1000);
+
+  return {
+    starts_at: startsAt.toISOString(),
+    ends_at: endsAt.toISOString(),
+    hold_expires_at: holdExpiresAt.toISOString(),
+  };
+}
diff --git a/src/lib/clinic-time.ts b/src/lib/clinic-time.ts
new file mode 100644
index 0000000..6fd5f39
--- /dev/null
+++ b/src/lib/clinic-time.ts
@@ -0,0 +1,76 @@
+// Zona horaria del consultorio. Todas las horas de slots ("09:00") se
+// interpretan en esta zona, sin importar el dispositivo del paciente.
+// TODO: moverla a una columna `timezone` en `tenants`.
+export const CLINIC_TIME_ZONE = "America/Mazatlan";
+
+export function getNowMs(): number {
+  return Date.now();
+}
+
+function getTimeZoneOffsetMs(date: Date, timeZone: string) {
+  const parts = new Intl.DateTimeFormat("en-US", {
+    timeZone,
+    hourCycle: "h23",
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+    hour: "2-digit",
+    minute: "2-digit",
+    second: "2-digit",
+  }).formatToParts(date);
+
+  const get = (type: string) =>
+    Number(parts.find((part) => part.type === type)?.value);
+
+  const asUtc = Date.UTC(
+    get("year"),
+    get("month") - 1,
+    get("day"),
+    get("hour"),
+    get("minute"),
+    get("second"),
+  );
+
+  return asUtc - date.getTime();
+}
+
+/** "2026-10-16" + "09:30" (hora del consultorio) → instante UTC. */
+export function zonedDateTimeToUtc(
+  isoDate: string,
+  time: string,
+  timeZone: string = CLINIC_TIME_ZONE,
+): Date {
+  const normalized = time.length === 5 ? `${time}:00` : time;
+  const guess = new Date(`${isoDate}T${normalized}Z`);
+  return new Date(guess.getTime() - getTimeZoneOffsetMs(guess, timeZone));
+}
+
+/** Instante → fecha "YYYY-MM-DD" en la zona del consultorio. */
+export function getClinicDateIso(
+  date: Date | string,
+  timeZone: string = CLINIC_TIME_ZONE,
+): string {
+  return new Intl.DateTimeFormat("en-CA", {
+    timeZone,
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  }).format(new Date(date));
+}
+
+/** Instante → hora "HH:MM" (24 h) en la zona del consultorio. */
+export function getClinicTime(
+  date: Date | string,
+  timeZone: string = CLINIC_TIME_ZONE,
+): string {
+  return new Intl.DateTimeFormat("en-GB", {
+    timeZone,
+    hour: "2-digit",
+    minute: "2-digit",
+    hourCycle: "h23",
+  }).format(new Date(date));
+}
+
+export function getClinicTodayIso(): string {
+  return getClinicDateIso(new Date());
+}
