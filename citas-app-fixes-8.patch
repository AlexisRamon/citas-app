diff --git a/src/app/doctor/(panel)/disponibilidad/BlocksManager.tsx b/src/app/doctor/(panel)/disponibilidad/BlocksManager.tsx
new file mode 100644
index 0000000..fffa865
--- /dev/null
+++ b/src/app/doctor/(panel)/disponibilidad/BlocksManager.tsx
@@ -0,0 +1,235 @@
+"use client";
+
+import { useState } from "react";
+import { useRouter } from "next/navigation";
+import { CalendarOff, CircleCheck, Trash2 } from "lucide-react";
+import { Alert } from "@/components/ui/Alert";
+import { Button } from "@/components/ui/Button";
+import { DateTimeInput } from "@/components/ui/DateTimeInput";
+import { Input } from "@/components/ui/Input";
+import { getClinicDateIso, getClinicTime } from "@/lib/clinic-time";
+import { formatLongDate, formatTimeLabel } from "@/lib/format-date";
+import { createBlock, deleteBlock } from "./actions";
+
+export type BlockRow = {
+  id: string;
+  starts_at: string;
+  ends_at: string;
+  reason: string | null;
+};
+
+type Mode = "dias" | "horas";
+
+function describeBlock(block: BlockRow) {
+  const startDate = getClinicDateIso(block.starts_at);
+  const startTime = getClinicTime(block.starts_at);
+  const endTime = getClinicTime(block.ends_at);
+
+  if (startTime === "00:00" && endTime === "00:00") {
+    const lastDate = getClinicDateIso(new Date(new Date(block.ends_at).getTime() - 1));
+
+    return lastDate === startDate
+      ? `${formatLongDate(startDate)} · todo el día`
+      : `Del ${formatLongDate(startDate)} al ${formatLongDate(lastDate)}`;
+  }
+
+  return `${formatLongDate(startDate)} · ${formatTimeLabel(startTime)} a ${formatTimeLabel(endTime)}`;
+}
+
+type BlocksManagerProps = {
+  blocks: BlockRow[];
+  todayIso: string;
+};
+
+export function BlocksManager({ blocks, todayIso }: BlocksManagerProps) {
+  const router = useRouter();
+
+  const [mode, setMode] = useState<Mode>("dias");
+  const [startDate, setStartDate] = useState(todayIso);
+  const [endDate, setEndDate] = useState(todayIso);
+  const [startTime, setStartTime] = useState("09:00");
+  const [endTime, setEndTime] = useState("10:00");
+  const [reason, setReason] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | undefined>(undefined);
+  const [notice, setNotice] = useState<string | undefined>(undefined);
+
+  async function handleCreate() {
+    if (busy) return;
+
+    setBusy(true);
+    setError(undefined);
+    setNotice(undefined);
+
+    const result = await createBlock({
+      allDay: mode === "dias",
+      startDate,
+      endDate: mode === "dias" ? endDate : startDate,
+      startTime,
+      endTime,
+      reason,
+    });
+
+    setBusy(false);
+
+    if (!result.ok) {
+      setError(result.error);
+      return;
+    }
+
+    setReason("");
+    setNotice("Bloqueo creado. Esos horarios ya no se pueden reservar.");
+    router.refresh();
+  }
+
+  async function handleDelete(block: BlockRow) {
+    if (busy) return;
+
+    if (!window.confirm("¿Quitar este bloqueo? Los horarios volverán a estar disponibles.")) {
+      return;
+    }
+
+    setBusy(true);
+    setError(undefined);
+    setNotice(undefined);
+
+    const result = await deleteBlock(block.id);
+
+    setBusy(false);
+
+    if (!result.ok) {
+      setError(result.error);
+      return;
+    }
+
+    setNotice("Bloqueo eliminado.");
+    router.refresh();
+  }
+
+  return (
+    <div className="flex flex-col gap-ds-4">
+      {notice ? (
+        <Alert variant="info" icon={CircleCheck} title={notice} />
+      ) : null}
+      {error ? <Alert variant="danger" title={error} /> : null}
+
+      <div className="flex flex-col gap-ds-4 rounded-md border border-border bg-surface p-ds-4">
+        <div
+          role="radiogroup"
+          aria-label="Tipo de bloqueo"
+          className="flex flex-wrap gap-ds-2"
+        >
+          {(
+            [
+              { value: "dias", label: "Día o varios días" },
+              { value: "horas", label: "Rango de horas" },
+            ] as const
+          ).map((option) => {
+            const active = mode === option.value;
+
+            return (
+              <button
+                key={option.value}
+                type="button"
+                role="radio"
+                aria-checked={active}
+                onClick={() => setMode(option.value)}
+                className={`flex min-h-[44px] items-center rounded-sm px-ds-4 text-16 ${
+                  active
+                    ? "bg-surface-soft font-bold text-primary"
+                    : "text-text-muted hover:bg-surface-soft"
+                }`}
+              >
+                {option.label}
+              </button>
+            );
+          })}
+        </div>
+
+        <div className="flex flex-wrap items-end gap-ds-3">
+          <DateTimeInput
+            type="date"
+            label={mode === "dias" ? "Desde" : "Fecha"}
+            min={todayIso}
+            value={startDate}
+            onChange={(value) => {
+              setStartDate(value);
+              if (endDate < value) setEndDate(value);
+            }}
+          />
+          {mode === "dias" ? (
+            <DateTimeInput
+              type="date"
+              label="Hasta"
+              min={startDate}
+              value={endDate}
+              onChange={setEndDate}
+            />
+          ) : (
+            <>
+              <DateTimeInput
+                type="time"
+                label="De"
+                step={30 * 60}
+                value={startTime}
+                onChange={setStartTime}
+              />
+              <DateTimeInput
+                type="time"
+                label="A"
+                step={30 * 60}
+                value={endTime}
+                onChange={setEndTime}
+              />
+            </>
+          )}
+        </div>
+
+        <Input
+          label="Motivo (opcional, solo lo ves tú)"
+          placeholder="Ej. Vacaciones, congreso, cita personal"
+          value={reason}
+          onChange={setReason}
+        />
+
+        <Button
+          variant={busy ? "disabled" : "primary"}
+          icon={<CalendarOff size={20} aria-hidden="true" />}
+          onClick={handleCreate}
+          className="w-full lg:w-auto lg:self-start"
+        >
+          {busy ? "Guardando…" : "Bloquear"}
+        </Button>
+      </div>
+
+      {blocks.length === 0 ? (
+        <p className="text-14 text-text-muted">No tienes bloqueos próximos.</p>
+      ) : (
+        <ul className="flex flex-col gap-ds-2">
+          {blocks.map((block) => (
+            <li
+              key={block.id}
+              className="flex items-center gap-ds-3 rounded-md border border-border bg-surface p-ds-4"
+            >
+              <div className="flex min-w-0 flex-1 flex-col gap-ds-1">
+                <p className="text-16 font-bold text-text">{describeBlock(block)}</p>
+                {block.reason ? (
+                  <p className="truncate text-14 text-text-muted">{block.reason}</p>
+                ) : null}
+              </div>
+              <button
+                type="button"
+                onClick={() => handleDelete(block)}
+                disabled={busy}
+                aria-label={`Quitar bloqueo: ${describeBlock(block)}`}
+                className="flex size-[44px] shrink-0 items-center justify-center rounded-sm text-danger hover:bg-surface-soft"
+              >
+                <Trash2 size={20} aria-hidden="true" />
+              </button>
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
diff --git a/src/app/doctor/(panel)/disponibilidad/ScheduleEditor.tsx b/src/app/doctor/(panel)/disponibilidad/ScheduleEditor.tsx
new file mode 100644
index 0000000..ca5fd96
--- /dev/null
+++ b/src/app/doctor/(panel)/disponibilidad/ScheduleEditor.tsx
@@ -0,0 +1,234 @@
+"use client";
+
+import { useState } from "react";
+import { useRouter } from "next/navigation";
+import { CircleCheck, Plus, Save, X } from "lucide-react";
+import { Alert } from "@/components/ui/Alert";
+import { Button } from "@/components/ui/Button";
+import { DateTimeInput } from "@/components/ui/DateTimeInput";
+import {
+  validateWindows,
+  type AvailabilityRule,
+  type TimeWindow,
+} from "@/lib/availability";
+import { saveSchedule } from "./actions";
+
+type DayState = { open: boolean; windows: TimeWindow[] };
+
+const DAY_ORDER = [1, 2, 3, 4, 5, 6, 0];
+const DAY_LABELS = [
+  "Domingo",
+  "Lunes",
+  "Martes",
+  "Miércoles",
+  "Jueves",
+  "Viernes",
+  "Sábado",
+];
+const MAX_WINDOWS = 3;
+const SLOT_STEP_SECONDS = 30 * 60;
+
+function buildInitial(rules: AvailabilityRule[]): DayState[] {
+  return Array.from({ length: 7 }, (_, weekday) => {
+    const windows = rules
+      .filter((rule) => rule.weekday === weekday)
+      .map((rule) => ({ start: rule.start, end: rule.end }))
+      .sort((a, b) => a.start.localeCompare(b.start));
+
+    return {
+      open: windows.length > 0,
+      windows: windows.length > 0 ? windows : [{ start: "09:00", end: "12:00" }],
+    };
+  });
+}
+
+type ScheduleEditorProps = {
+  initialRules: AvailabilityRule[];
+};
+
+export function ScheduleEditor({ initialRules }: ScheduleEditorProps) {
+  const router = useRouter();
+
+  const [days, setDays] = useState<DayState[]>(() => buildInitial(initialRules));
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState<string | undefined>(undefined);
+  const [saved, setSaved] = useState(false);
+
+  const issues = days.map((day) => (day.open ? validateWindows(day.windows) : null));
+  const hasIssues = issues.some(Boolean);
+  const hasOpenDay = days.some((day) => day.open);
+
+  function updateDay(weekday: number, change: (day: DayState) => DayState) {
+    setDays((current) =>
+      current.map((day, index) => (index === weekday ? change(day) : day)),
+    );
+    setSaved(false);
+    setError(undefined);
+  }
+
+  async function handleSave() {
+    if (saving || hasIssues) return;
+
+    setSaving(true);
+    setError(undefined);
+    setSaved(false);
+
+    const rules: AvailabilityRule[] = days.flatMap((day, weekday) =>
+      day.open
+        ? day.windows.map((window) => ({
+            weekday,
+            start: window.start,
+            end: window.end,
+          }))
+        : [],
+    );
+
+    const result = await saveSchedule(rules);
+
+    setSaving(false);
+
+    if (!result.ok) {
+      setError(result.error);
+      return;
+    }
+
+    setSaved(true);
+    router.refresh();
+  }
+
+  return (
+    <div className="flex flex-col gap-ds-4">
+      {saved ? (
+        <Alert
+          variant="info"
+          icon={CircleCheck}
+          title="Horario guardado"
+          description="Tus pacientes ya ven los nuevos horarios."
+        />
+      ) : null}
+      {error ? <Alert variant="danger" title={error} /> : null}
+      {!hasOpenDay ? (
+        <Alert
+          variant="warning"
+          title="No hay ningún día abierto"
+          description="Mientras tanto, los pacientes no podrán agendar."
+        />
+      ) : null}
+
+      <ul className="flex flex-col gap-ds-3">
+        {DAY_ORDER.map((weekday) => {
+          const day = days[weekday];
+          const label = DAY_LABELS[weekday];
+          const issue = issues[weekday];
+
+          return (
+            <li
+              key={weekday}
+              className="flex flex-col gap-ds-3 rounded-md border border-border bg-surface p-ds-4"
+            >
+              <label className="flex min-h-[44px] items-center gap-ds-3 text-16 font-bold text-text">
+                <input
+                  type="checkbox"
+                  checked={day.open}
+                  onChange={(event) =>
+                    updateDay(weekday, (current) => ({
+                      ...current,
+                      open: event.target.checked,
+                    }))
+                  }
+                  className="size-[24px] accent-primary"
+                />
+                {label}
+              </label>
+
+              {day.open ? (
+                <div className="flex flex-col gap-ds-3">
+                  {day.windows.map((window, index) => (
+                    <div key={index} className="flex flex-wrap items-end gap-ds-3">
+                      <DateTimeInput
+                        type="time"
+                        step={SLOT_STEP_SECONDS}
+                        label={`Desde (${label}, horario ${index + 1})`}
+                        value={window.start}
+                        onChange={(value) =>
+                          updateDay(weekday, (current) => ({
+                            ...current,
+                            windows: current.windows.map((item, i) =>
+                              i === index ? { ...item, start: value } : item,
+                            ),
+                          }))
+                        }
+                      />
+                      <DateTimeInput
+                        type="time"
+                        step={SLOT_STEP_SECONDS}
+                        label={`Hasta (${label}, horario ${index + 1})`}
+                        value={window.end}
+                        onChange={(value) =>
+                          updateDay(weekday, (current) => ({
+                            ...current,
+                            windows: current.windows.map((item, i) =>
+                              i === index ? { ...item, end: value } : item,
+                            ),
+                          }))
+                        }
+                      />
+                      {day.windows.length > 1 ? (
+                        <button
+                          type="button"
+                          aria-label={`Quitar horario ${index + 1} de ${label}`}
+                          onClick={() =>
+                            updateDay(weekday, (current) => ({
+                              ...current,
+                              windows: current.windows.filter((_, i) => i !== index),
+                            }))
+                          }
+                          className="flex size-[56px] items-center justify-center rounded-sm text-text-muted hover:bg-surface-soft"
+                        >
+                          <X size={20} aria-hidden="true" />
+                        </button>
+                      ) : null}
+                    </div>
+                  ))}
+
+                  {issue ? (
+                    <p role="alert" className="text-14 text-danger">
+                      {issue}
+                    </p>
+                  ) : null}
+
+                  {day.windows.length < MAX_WINDOWS ? (
+                    <button
+                      type="button"
+                      onClick={() =>
+                        updateDay(weekday, (current) => ({
+                          ...current,
+                          windows: [...current.windows, { start: "16:00", end: "17:00" }],
+                        }))
+                      }
+                      className="flex min-h-[44px] items-center gap-ds-2 self-start text-14 font-bold text-primary"
+                    >
+                      <Plus size={16} aria-hidden="true" />
+                      Agregar horario
+                    </button>
+                  ) : null}
+                </div>
+              ) : (
+                <p className="text-14 text-text-muted">Cerrado</p>
+              )}
+            </li>
+          );
+        })}
+      </ul>
+
+      <Button
+        variant={saving || hasIssues ? "disabled" : "primary"}
+        icon={<Save size={20} aria-hidden="true" />}
+        onClick={handleSave}
+        className="w-full lg:w-auto"
+      >
+        {saving ? "Guardando…" : "Guardar horario"}
+      </Button>
+    </div>
+  );
+}
diff --git a/src/app/doctor/(panel)/disponibilidad/actions.ts b/src/app/doctor/(panel)/disponibilidad/actions.ts
new file mode 100644
index 0000000..85ed4cf
--- /dev/null
+++ b/src/app/doctor/(panel)/disponibilidad/actions.ts
@@ -0,0 +1,200 @@
+"use server";
+
+import { getNowMs, zonedDateTimeToUtc } from "@/lib/clinic-time";
+import {
+  isValidClockTime,
+  validateWindows,
+  type AvailabilityRule,
+} from "@/lib/availability";
+import { isValidIsoDate, parseIsoDate, toIsoDate } from "@/lib/format-date";
+import { createClient } from "@/lib/supabase/server";
+
+export type ActionResult = { ok: true } | { ok: false; error: string };
+
+const UUID_REGEX =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const MAX_WINDOWS_PER_DAY = 3;
+const MAX_BLOCK_DAYS = 366;
+const MAX_REASON_LENGTH = 120;
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+async function getContext() {
+  const supabase = await createClient();
+
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+
+  if (!user) return null;
+
+  const { data: profile } = await supabase
+    .from("doctor_profiles")
+    .select("tenant_id")
+    .eq("user_id", user.id)
+    .maybeSingle<{ tenant_id: string }>();
+
+  if (!profile) return null;
+
+  return { supabase, tenantId: profile.tenant_id };
+}
+
+const NO_ACCESS: ActionResult = {
+  ok: false,
+  error: "Tu sesión expiró o no tienes acceso. Inicia sesión de nuevo.",
+};
+
+function addDaysIso(isoDate: string, amount: number) {
+  const next = parseIsoDate(isoDate);
+  next.setDate(next.getDate() + amount);
+  return toIsoDate(next);
+}
+
+export async function saveSchedule(
+  rules: AvailabilityRule[],
+): Promise<ActionResult> {
+  if (!Array.isArray(rules)) return { ok: false, error: "Horario inválido." };
+
+  for (let weekday = 0; weekday <= 6; weekday += 1) {
+    const windows = rules.filter((rule) => rule.weekday === weekday);
+
+    if (windows.length > MAX_WINDOWS_PER_DAY) {
+      return { ok: false, error: "Máximo 3 horarios por día." };
+    }
+
+    const issue = validateWindows(windows);
+    if (issue) return { ok: false, error: issue };
+  }
+
+  if (
+    rules.some(
+      (rule) =>
+        !Number.isInteger(rule.weekday) || rule.weekday < 0 || rule.weekday > 6,
+    )
+  ) {
+    return { ok: false, error: "Horario inválido." };
+  }
+
+  const context = await getContext();
+  if (!context) return NO_ACCESS;
+
+  const { error } = await context.supabase.rpc("save_availability_rules", {
+    p_tenant: context.tenantId,
+    p_rules: rules.map((rule) => ({
+      weekday: rule.weekday,
+      start: rule.start,
+      end: rule.end,
+    })),
+  });
+
+  if (error) {
+    return { ok: false, error: "No pudimos guardar el horario. Inténtalo de nuevo." };
+  }
+
+  return { ok: true };
+}
+
+export type BlockInput = {
+  allDay: boolean;
+  startDate: string;
+  endDate: string;
+  startTime: string;
+  endTime: string;
+  reason: string;
+};
+
+export async function createBlock(input: BlockInput): Promise<ActionResult> {
+  if (!isValidIsoDate(input.startDate)) {
+    return { ok: false, error: "Elige una fecha válida." };
+  }
+
+  const reason = (input.reason ?? "").trim().slice(0, MAX_REASON_LENGTH);
+
+  let startsAt: Date;
+  let endsAt: Date;
+
+  if (input.allDay) {
+    if (!isValidIsoDate(input.endDate) || input.endDate < input.startDate) {
+      return { ok: false, error: "La fecha final no puede ser anterior a la inicial." };
+    }
+
+    const days =
+      (parseIsoDate(input.endDate).getTime() -
+        parseIsoDate(input.startDate).getTime()) /
+        DAY_MS +
+      1;
+    if (days > MAX_BLOCK_DAYS) {
+      return { ok: false, error: "Puedes bloquear hasta 1 año de una vez." };
+    }
+
+    startsAt = zonedDateTimeToUtc(input.startDate, "00:00:00");
+    endsAt = zonedDateTimeToUtc(addDaysIso(input.endDate, 1), "00:00:00");
+  } else {
+    if (!isValidClockTime(input.startTime) || !isValidClockTime(input.endTime)) {
+      return { ok: false, error: "Ingresa horas válidas." };
+    }
+    if (input.endTime <= input.startTime) {
+      return { ok: false, error: "La hora final debe ser posterior a la inicial." };
+    }
+
+    startsAt = zonedDateTimeToUtc(input.startDate, input.startTime);
+    endsAt = zonedDateTimeToUtc(input.startDate, input.endTime);
+  }
+
+  if (endsAt.getTime() <= getNowMs()) {
+    return { ok: false, error: "No puedes bloquear un periodo que ya pasó." };
+  }
+
+  const context = await getContext();
+  if (!context) return NO_ACCESS;
+
+  const { count, error: countError } = await context.supabase
+    .from("appointments")
+    .select("id", { count: "exact", head: true })
+    .eq("tenant_id", context.tenantId)
+    .eq("status", "confirmed")
+    .lt("starts_at", endsAt.toISOString())
+    .gt("ends_at", startsAt.toISOString());
+
+  if (countError) {
+    return { ok: false, error: "No pudimos revisar tus citas. Inténtalo de nuevo." };
+  }
+
+  if (count && count > 0) {
+    return {
+      ok: false,
+      error: `Hay ${count} ${count === 1 ? "cita confirmada" : "citas confirmadas"} en ese periodo. Cancélalas primero en Citas.`,
+    };
+  }
+
+  const { error } = await context.supabase.from("availability_blocks").insert({
+    tenant_id: context.tenantId,
+    starts_at: startsAt.toISOString(),
+    ends_at: endsAt.toISOString(),
+    reason: reason || null,
+  });
+
+  if (error) {
+    return { ok: false, error: "No pudimos crear el bloqueo. Inténtalo de nuevo." };
+  }
+
+  return { ok: true };
+}
+
+export async function deleteBlock(id: string): Promise<ActionResult> {
+  if (!UUID_REGEX.test(id)) return { ok: false, error: "Bloqueo inválido." };
+
+  const context = await getContext();
+  if (!context) return NO_ACCESS;
+
+  const { error, count } = await context.supabase
+    .from("availability_blocks")
+    .delete({ count: "exact" })
+    .eq("id", id)
+    .eq("tenant_id", context.tenantId);
+
+  if (error || !count) {
+    return { ok: false, error: "No pudimos quitar el bloqueo. Inténtalo de nuevo." };
+  }
+
+  return { ok: true };
+}
