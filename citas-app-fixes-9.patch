diff --git a/src/app/[tenant]/agendar/resumen/actions.ts b/src/app/[tenant]/agendar/resumen/actions.ts
new file mode 100644
index 0000000..db17a1f
--- /dev/null
+++ b/src/app/[tenant]/agendar/resumen/actions.ts
@@ -0,0 +1,143 @@
+"use server";
+
+import { SLOT_MINUTES, getSlotStart } from "@/lib/booking";
+import { buildConfirmationEmail } from "@/lib/booking-email";
+import { getClinicDateIso, getClinicTime, getNowMs } from "@/lib/clinic-time";
+import { sendEmail } from "@/lib/email";
+import {
+  formatLongDate,
+  formatTimeLabel,
+  isValidIsoDate,
+  isValidTime,
+} from "@/lib/format-date";
+import { createClient } from "@/lib/supabase/server";
+import { getTenantBySlug } from "@/lib/tenant";
+
+export type BookingResult =
+  | { ok: true; emailSent: boolean }
+  | { ok: false; error: string; slotUnavailable?: boolean };
+
+type BookingInput = {
+  slug: string;
+  date: string;
+  time: string;
+  name: string;
+};
+
+// Tope de citas futuras confirmadas por paciente en un consultorio.
+const MAX_UPCOMING_APPOINTMENTS = 5;
+const MAX_NAME_LENGTH = 120;
+const SLOT_TAKEN_CODES = ["23P01", "23505"];
+
+export async function bookAppointment(input: BookingInput): Promise<BookingResult> {
+  const name = (input.name ?? "").trim().slice(0, MAX_NAME_LENGTH);
+
+  if (
+    typeof input.slug !== "string" ||
+    !isValidIsoDate(input.date) ||
+    !isValidTime(input.time) ||
+    name.length < 2
+  ) {
+    return { ok: false, error: "Revisa los datos de tu cita e inténtalo de nuevo." };
+  }
+
+  const tenant = await getTenantBySlug(input.slug);
+  if (!tenant) return { ok: false, error: "No encontramos el consultorio." };
+
+  if (tenant.currentStatus === "agenda-cerrada") {
+    return {
+      ok: false,
+      error: "El consultorio cerró su agenda por ahora. Intenta más tarde.",
+    };
+  }
+
+  const supabase = await createClient();
+
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+
+  if (!user || !user.email) {
+    return { ok: false, error: "Tu sesión expiró. Inicia sesión de nuevo." };
+  }
+
+  const { count: upcoming, error: countError } = await supabase
+    .from("appointments")
+    .select("id", { count: "exact", head: true })
+    .eq("tenant_id", tenant.id)
+    .eq("patient_id", user.id)
+    .eq("status", "confirmed")
+    .gte("starts_at", new Date(getNowMs()).toISOString());
+
+  if (countError) {
+    return { ok: false, error: "No pudimos confirmar tu cita. Inténtalo de nuevo." };
+  }
+
+  if ((upcoming ?? 0) >= MAX_UPCOMING_APPOINTMENTS) {
+    return {
+      ok: false,
+      error: `Ya tienes ${MAX_UPCOMING_APPOINTMENTS} citas próximas con este consultorio. Cancela o espera a que pase alguna.`,
+    };
+  }
+
+  const startsAt = getSlotStart(input.date, input.time);
+  const endsAt = new Date(startsAt.getTime() + SLOT_MINUTES * 60 * 1000);
+
+  const { error: insertError } = await supabase.from("appointments").insert({
+    id: crypto.randomUUID(),
+    tenant_id: tenant.id,
+    patient_id: user.id,
+    patient_name: name,
+    patient_email: user.email,
+    starts_at: startsAt.toISOString(),
+    ends_at: endsAt.toISOString(),
+    status: "confirmed",
+  });
+
+  if (insertError) {
+    const message = insertError.message ?? "";
+
+    if (message.includes("agenda_closed")) {
+      return {
+        ok: false,
+        error: "El consultorio cerró su agenda por ahora. Intenta más tarde.",
+      };
+    }
+    if (message.includes("outside_hours")) {
+      return {
+        ok: false,
+        error: "Ese horario está fuera del horario de atención. Elige otro.",
+        slotUnavailable: true,
+      };
+    }
+    if (message.includes("invalid_start")) {
+      return { ok: false, error: "Ese horario ya pasó. Elige otro.", slotUnavailable: true };
+    }
+    if (SLOT_TAKEN_CODES.includes(insertError.code ?? "")) {
+      return {
+        ok: false,
+        error: "Ese horario ya no está disponible. Elige otro.",
+        slotUnavailable: true,
+      };
+    }
+
+    return { ok: false, error: "No pudimos confirmar tu cita. Inténtalo de nuevo." };
+  }
+
+  // La cita ya está confirmada: si el correo falla, no se revierte.
+  const domain = process.env.NEXT_PUBLIC_APP_DOMAIN;
+
+  const email = buildConfirmationEmail({
+    patientName: name,
+    doctorName: tenant.name,
+    dateLabel: formatLongDate(getClinicDateIso(startsAt)),
+    timeLabel: formatTimeLabel(getClinicTime(startsAt)),
+    address: tenant.address || (tenant.addressLines ?? []).join(", "),
+    phone: tenant.phone,
+    myAppointmentsUrl: domain ? `https://${domain}/${tenant.slug}/mi-cita` : null,
+  });
+
+  const emailSent = await sendEmail({ to: user.email, ...email });
+
+  return { ok: true, emailSent };
+}
diff --git a/src/lib/booking-email.ts b/src/lib/booking-email.ts
new file mode 100644
index 0000000..2024a62
--- /dev/null
+++ b/src/lib/booking-email.ts
@@ -0,0 +1,68 @@
+import { escapeHtml } from "@/lib/email";
+
+type ConfirmationEmailInput = {
+  patientName: string;
+  doctorName: string;
+  dateLabel: string;
+  timeLabel: string;
+  address: string;
+  phone: string;
+  myAppointmentsUrl: string | null;
+};
+
+export function buildConfirmationEmail(input: ConfirmationEmailInput) {
+  const subject = `Cita confirmada: ${input.dateLabel} a las ${input.timeLabel}`;
+
+  const text = [
+    `Hola ${input.patientName},`,
+    "",
+    `Tu cita con ${input.doctorName} quedó confirmada.`,
+    "",
+    `Fecha: ${input.dateLabel}`,
+    `Hora: ${input.timeLabel}`,
+    input.address ? `Dirección: ${input.address}` : "",
+    input.phone ? `Teléfono: ${input.phone}` : "",
+    input.myAppointmentsUrl ? `\nPuedes ver tus citas aquí: ${input.myAppointmentsUrl}` : "",
+    "\nSi no puedes asistir, contacta al consultorio con anticipación.",
+  ]
+    .filter((line, index, all) => line !== "" || all[index - 1] !== "")
+    .join("\n");
+
+  const e = escapeHtml;
+
+  const rows = [
+    ["Doctor", input.doctorName],
+    ["Fecha", input.dateLabel],
+    ["Hora", input.timeLabel],
+    ["Dirección", input.address],
+    ["Teléfono", input.phone],
+  ].filter(([, value]) => value);
+
+  const html = `
+<div style="font-family: Arial, Helvetica, sans-serif; max-width: 480px; margin: 0 auto; padding: 24px; color: #243b36;">
+  <h2 style="margin: 0 0 12px; font-size: 20px;">¡Cita confirmada!</h2>
+  <p style="margin: 0 0 16px; font-size: 14px;">Hola ${e(input.patientName)}, tu cita quedó agendada.</p>
+  <table style="width: 100%; border-collapse: collapse; margin: 0 0 16px; font-size: 14px;">
+    ${rows
+      .map(
+        ([label, value]) => `<tr>
+      <td style="padding: 8px 0; color: #65736e; width: 96px; vertical-align: top;">${e(label)}</td>
+      <td style="padding: 8px 0; font-weight: bold;">${e(value)}</td>
+    </tr>`,
+      )
+      .join("")}
+  </table>
+  ${
+    input.myAppointmentsUrl
+      ? `<p style="margin: 0 0 16px; font-size: 14px;">
+    <a href="${e(input.myAppointmentsUrl)}" style="color: #28685c;">Ver mis citas</a>
+  </p>`
+      : ""
+  }
+  <p style="margin: 0; font-size: 12px; color: #65736e;">
+    Si no puedes asistir, contacta al consultorio con anticipación.
+  </p>
+</div>`.trim();
+
+  return { subject, html, text };
+}
